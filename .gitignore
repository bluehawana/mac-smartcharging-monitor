# Build output
.build/
build/
docs/appstore/
docs/appstore-ready/
.swiftpm/
*.xcuserstate
xcuserdata/
.DS_Store

# Local configuration — non-secret overrides only, but never committed
.env
.env.*
!.env.example

# Credentials and signing material. Nothing here should ever be tracked;
# the real notary credential lives in the macOS keychain, not on disk.
*.p8
*.p12
*.pem
*.key
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
Smart_Charging_*.provisionprofile
Resources/embedded.provisionprofile
AuthKey_*
secrets/

# Certificate material. None of this belongs in a repository — the private key
# lives in the login keychain, and certificates are re-downloadable from the
# developer portal. Listed by extension and by the names the portal uses.
*.certSigningRequest
distribution.cer
mac_installer.cer
*_installer.cer
csr/
tmp/
