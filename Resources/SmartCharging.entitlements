<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mandatory for the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Nothing else is requested. The app reads the AppleSmartBattery
	     IOService, which the sandbox permits, and does not open files,
	     use the network, or access the camera, microphone or contacts.
	     Verified: a sandboxed build returns full sensor readings. -->
</dict>
</plist>
